{
	"name": "vasildakov/mezzio-doctrine-orm",
	"type": "library",
	"description": "Simple Laminas/Mezzio Doctrine ORM integration",
	"license": "BSD-3-Clause",
	"keywords": [
		"doctrine",
		"orm",
		"laminas",
		"mezzio"
	],
	"authors": [
		{
			"name": "Skar",
			"email": "sskarr@gmail.com",
			"homepage": "https://skar.pw/"
		},
		{
			"name": "Vasil Dakov",
			"email": "vasildakov@gmail.com",
			"homepage": "https://vasildakov.com/"
		}
	],
	"require": {
		"php": "^8.1 || ^8.2 || ^8.3 || ^8.4",
		"psr/container": "^1.0 || ^2.0",
		"doctrine/orm": "^3.0.0",
		"doctrine/migrations": "^3.9",
		"laminas/laminas-cli": "^1.0.0",
		"laminas/laminas-servicemanager": "~3.3 || ~4.0",
		"symfony/cache": "^8.0",
		"symfony/string": "^8.0",
		"symfony/cache-contracts": "^3.6",
		"symfony/console": "^7.4"
	},
	"require-dev": {
		"phpunit/phpunit": "^8.5 || ^9.0 || ^10.0 || ^11.0",
		"squizlabs/php_codesniffer": "^3.5.0",
		"symfony/var-dumper": "^8.0",
		"doctrine/data-fixtures": "^2.2"
	},
	"autoload": {
		"psr-4": {
			"VasilDakov\\Doctrine\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"VasilDakov\\DoctrineTest\\": "test/"
		}
	},
	"suggest": {
		"doctrine/migrations": "doctrine migrations if you want to keep your schema definitions versioned"
	},
	"scripts": {
		"check": [
			"@cs-check",
			"@test"
		],
		"cs-check": "phpcs",
		"cs-fix": "phpcbf",
		"test": "phpunit --colors=always",
		"test-coverage": "phpunit --coverage-clover build/clover.xml"
	},
	"config": {
		"allow-plugins": {
			"composer/package-versions-deprecated": true
		}
	}
}
